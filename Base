#include <Servo.h>

Servo myservo;
const int buttonPin = 2; -- New button location

int lastState = HIGH;
int currentState;
bool servoActive = false;

void setup() {
  myservo.attach(9);
  pinMode(buttonPin, INPUT_PULLUP);
  myservo.write(90); // Stop the servo initially
}

void loop() {
  currentState = digitalRead(buttonPin);

  if (lastState == LOW && currentState == HIGH && !servoActive) {
    servoActive = true;
    myservo.write(100); // Spin forward
    delay(3000);        // Spin for 3 seconds
    myservo.write(90);  // Stop
  }

  if (currentState == HIGH) {
    servoActive = false;
  }

  lastState = currentState;
}
